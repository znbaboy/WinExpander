<Page
    x:Class="WinExpander.SnippetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinExpander"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Grid Padding="12,12,16,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="200" MaxWidth="440" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" MinWidth="360" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.AddSnippetCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Add" />
                    <TextBlock Text="New snippet" />
                </StackPanel>
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="N" />
                </Button.KeyboardAccelerators>
            </Button>

            <ListView x:Name="SnippetList" Grid.Row="1" Margin="-4,0"
                      ItemsSource="{x:Bind ViewModel.Snippets}"
                      SelectionChanged="SnippetList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:Snippet">
                        <StackPanel Padding="0,8" Spacing="2">
                            <TextBlock Text="{x:Bind DisplayTrigger, Mode=OneWay}"
                                       FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind Summary, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid Grid.Row="2" Margin="4,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ToggleSwitch IsOn="{x:Bind ViewModel.ExpansionEnabled, Mode=TwoWay}"
                              OnContent="Expansion on" OffContent="Expansion paused" />
                <Button Grid.Column="1" VerticalAlignment="Center" Command="{x:Bind ViewModel.OpenSettingsCommand}"
                        ToolTipService.ToolTip="Settings" AutomationProperties.Name="Open settings">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Setting" />
                        <TextBlock Text="Settings" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <tk:GridSplitter Grid.Column="1" ResizeBehavior="BasedOnAlignment" ResizeDirection="Auto"
                         Background="Transparent" />

        <!-- Editor card -->
        <Grid Grid.Column="2"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1" CornerRadius="8">

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                        Visibility="{x:Bind local:BindHelpers.Collapsed(ViewModel.HasSelection), Mode=OneWay}">
                <FontIcon Glyph="&#xE70F;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="Create a snippet to get started" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Grid Padding="20,16,20,20" RowSpacing="12"
                  Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Trigger + delete -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TriggerBox" Header="Trigger" PlaceholderText=";abbr"
                             Width="280" HorizontalAlignment="Left"
                             FontFamily="Cascadia Mono, Consolas" IsSpellCheckEnabled="False"
                             Text="{x:Bind ViewModel.Selected.Trigger, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,8,6"
                               Text="{x:Bind ViewModel.SaveStatus, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <Button Grid.Column="2" VerticalAlignment="Bottom"
                            Command="{x:Bind ViewModel.DeleteSnippetCommand}"
                            ToolTipService.ToolTip="Delete snippet">
                        <SymbolIcon Symbol="Delete" />
                    </Button>
                </Grid>

                <!-- Markdown toolbar -->
                <CommandBar Grid.Row="1" HorizontalAlignment="Left" Margin="-4,0,0,0"
                            DefaultLabelPosition="Collapsed" Background="Transparent"
                            OverflowButtonVisibility="Collapsed">
                    <AppBarButton Label="Bold (Ctrl+B)" Tag="bold" Click="Format_Click" Icon="Bold">
                        <AppBarButton.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="B" />
                        </AppBarButton.KeyboardAccelerators>
                    </AppBarButton>
                    <AppBarButton Label="Italic (Ctrl+I)" Tag="italic" Click="Format_Click" Icon="Italic">
                        <AppBarButton.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="I" />
                        </AppBarButton.KeyboardAccelerators>
                    </AppBarButton>
                    <AppBarButton Label="Strikethrough" Tag="strike" Click="Format_Click">
                        <AppBarButton.Icon><FontIcon Glyph="&#xEDE0;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="Heading" Tag="heading" Click="Format_Click" Icon="Font" />
                    <AppBarSeparator />
                    <AppBarButton Label="Bulleted list" Tag="list" Click="Format_Click" Icon="List" />
                    <AppBarButton Label="Numbered list" Tag="numbered" Click="Format_Click">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE9D5;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="Task list" Tag="task" Click="Format_Click">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE73A;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="Quote" Tag="quote" Click="Format_Click">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE9B2;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarSeparator />
                    <AppBarButton Label="Link (Ctrl+K)" Tag="link" Click="Format_Click" Icon="Link">
                        <AppBarButton.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="K" />
                        </AppBarButton.KeyboardAccelerators>
                    </AppBarButton>
                    <AppBarButton Label="Inline code" Tag="code" Click="Format_Click">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE943;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="Table" Tag="table" Click="Format_Click">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE80A;" /></AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar>

                <!-- Editor | Preview -->
                <Grid Grid.Row="2" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="160" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" MinWidth="160" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Markdown" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Column="2" Text="Preview" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <TextBox x:Name="Editor" Grid.Row="1"
                             AcceptsReturn="True" TextWrapping="Wrap" IsSpellCheckEnabled="False"
                             FontFamily="Cascadia Mono, Consolas" FontSize="13"
                             PlaceholderText="Write your snippet in Markdown…"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Text="{x:Bind ViewModel.Selected.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="Editor_TextChanged" />

                    <tk:GridSplitter Grid.Row="1" Grid.Column="1" ResizeBehavior="BasedOnAlignment"
                                     ResizeDirection="Auto" Background="Transparent" />

                    <Border Grid.Row="1" Grid.Column="2" CornerRadius="4" BorderThickness="1"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                        <Grid x:Name="PreviewHost">
                            <!-- WebView2 is created on demand and released when hidden (saves ~100 MB) -->
                            <TextBlock x:Name="PreviewError" Visibility="Collapsed" Margin="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Preview needs the Microsoft Edge WebView2 Runtime." />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
