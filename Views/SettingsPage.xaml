<Page
    x:Class="WinExpander.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="1,28,0,6" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel MaxWidth="1000" Padding="36,24,36,36" Spacing="4">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

            <!-- Appearance -->
            <TextBlock Text="Appearance" Style="{StaticResource SectionHeader}" />
            <tk:SettingsCard Header="App theme" Description="Choose light, dark, or follow Windows">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE790;" /></tk:SettingsCard.HeaderIcon>
                <ComboBox MinWidth="200" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                    <x:String>Use system setting</x:String>
                    <x:String>Light</x:String>
                    <x:String>Dark</x:String>
                </ComboBox>
            </tk:SettingsCard>

            <!-- Behavior -->
            <TextBlock Text="Behavior" Style="{StaticResource SectionHeader}" />
            <tk:SettingsCard Header="Expansion" Description="Replace triggers with snippets as you type">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE765;" /></tk:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind ViewModel.ExpansionEnabled, Mode=TwoWay}" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="Close to system tray" Description="Keep running in the tray when the window is closed">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8FC;" /></tk:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind ViewModel.CloseToTray, Mode=TwoWay}" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="Start with Windows" Description="Start hidden in the tray when you sign in. Turn on again if you move the app folder.">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7E8;" /></tk:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" />
            </tk:SettingsCard>

            <!-- Pasting -->
            <TextBlock Text="Pasting" Style="{StaticResource SectionHeader}" />
            <tk:SettingsCard Header="Plain-text apps get"
                             Description="Rich-text apps (Word, Outlook, Gmail, Teams…) always get formatted text">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8C8;" /></tk:SettingsCard.HeaderIcon>
                <ComboBox MinWidth="200" SelectedIndex="{x:Bind ViewModel.PlainTextIndex, Mode=TwoWay}">
                    <x:String>Markdown source</x:String>
                    <x:String>Plain text</x:String>
                </ComboBox>
            </tk:SettingsCard>

            <!-- About -->
            <TextBlock Text="About" Style="{StaticResource SectionHeader}" />
            <tk:SettingsExpander Header="WinExpander" Description="Minimal, portable text expander for Windows">
                <tk:SettingsExpander.HeaderIcon>
                    <BitmapIcon UriSource="ms-appx:///Assets/icon.png" ShowAsMonochrome="False" />
                </tk:SettingsExpander.HeaderIcon>
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind VersionText}" />
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard Header="Source code" Description="MIT licensed"
                                     IsClickEnabled="True" Click="OpenRepo_Click">
                        <tk:SettingsCard.ActionIcon><FontIcon Glyph="&#xE8A7;" /></tk:SettingsCard.ActionIcon>
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="Snippets folder" Description="{x:Bind DataFolder}"
                                     IsClickEnabled="True" Click="OpenFolder_Click">
                        <tk:SettingsCard.ActionIcon><FontIcon Glyph="&#xE8A7;" /></tk:SettingsCard.ActionIcon>
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</Page>
